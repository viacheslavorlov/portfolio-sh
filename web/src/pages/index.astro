---
import Layout from "../layouts/Layout.astro";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
  <div class="app">
    <div class="mid">
      <aside class="sidebar">
        <div class="side-sec">
          <div class="sec-label">explorer</div>
          <div class="tree" id="tree"></div>
        </div>
        <div class="side-sec">
          <div class="sec-label">session</div>
          <div class="sess">
            <div class="s1">adrián vega</div>
            <div class="d2">senior full-stack</div>
            <div class="d2">7y · remote · UTC+2</div>
            <div class="grn s1">● open to work</div>
          </div>
        </div>
        <div class="side-sec">
          <div class="sec-label">theme</div>
          <div class="theme-row" id="themeRow"></div>
        </div>
      </aside>

      <main class="pane" id="pane">
        <div class="col">
          <div id="page"></div>
          <div class="tildes" aria-hidden="true">~ ~ ~ ~ ~</div>
        </div>
      </main>
    </div>

    <section class="console">
      <div class="console-head">
        <span class="sec-label">console</span>
        <span class="ch-dim">· output &amp; activity</span>
        <button class="linkbtn" id="clearBtn">[clear]</button>
      </div>
      <div class="console-body" id="consoleBody" role="log" aria-live="polite">
      </div>
    </section>

    <div class="cmdrow" id="cmdrow" title="command line — type help">
      <span class="prompt">❯</span>
      <div class="cmd-wrap" id="cmdWrap">
        <span class="mirror" id="mirror"></span><span
          class="caret"
          aria-hidden="true"></span>
        <input
          id="cmd"
          autocomplete="off"
          spellcheck="false"
          aria-label="command input"
        />
      </div>
      <span class="cmd-hint" id="cmdHint"
        >type help — or press ? for shortcuts · mouse works too</span
      >
    </div>

    <footer class="statusbar">
      <span class="mode" id="sbMode">NORMAL</span>
      <span class="sb-file" id="sbFile">about.md</span>
      <span class="sb-keys"
        >: cmd · j/k scroll · 1-4 tabs · t theme · ? help</span
      >
      <span class="sb-right">
        <span class="acc" id="sbTheme">amber</span>
        <span class="dim" id="sbClock">--:--:--</span>
        <span class="d2" id="sbTrace">trace 1a16a8b7</span>
      </span>
    </footer>
  </div>

  <div class="overlay" id="overlay">
    <div class="dialog" role="dialog" aria-modal="true">
      <div class="dlg-head">
        <span class="d2">┌</span><b id="dlgTitle">help</b><span
          class="d2"
          id="dlgSub"></span>
        <button class="linkbtn dlg-close" id="dlgClose">[esc] close</button>
      </div>
      <div class="dlg-body" id="dlgBody"></div>
    </div>
  </div>

  <script>
    import { ABOUT, ACH, CONTACT, PROJECTS, SKILLS, TABS, TREE } from "../data";

    /* ═══════════════ helpers ═══════════════ */
    const $ = (s: string): HTMLElement | null => document.querySelector(s);
    const h = (s: string) =>
      String(s).replace(
        /[&<>"']/g,
        (c) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[c],
      );
    const fmtTime = (d: Date) => d.toTimeString().slice(0, 8);
    const smooth = () =>
      matchMedia("(prefers-reduced-motion: reduce)").matches
        ? "auto"
        : "smooth";

    /* ═══════════════ data — single source of truth (pages, grep, cat all read this) ═══════════════ */

    /* ═══════════════ state ═══════════════ */
    const state = {
      page: "about",
      theme: "amber",
      open: new Set(["ledgerline"]),
      bootAt: Date.now(),
      hiring: false,
    };
    const hist = [];
    let hIdx = -1,
      gg = false;

    /* ═══════════════ DOM refs ═══════════════ */
    const cmd = $("#cmd"),
      mirror = $("#mirror"),
      pane = $("#pane"),
      pageEl = $("#page"),
      conBody = $("#consoleBody"),
      treeEl = $("#tree"),
      tabsEl = $("#tabs"),
      overlay = $("#overlay"),
      dlgTitle = $("#dlgTitle"),
      dlgSub = $("#dlgSub"),
      dlgBody = $("#dlgBody");

    /* ═══════════════ console ═══════════════ */
    const entries: { t: string; kind: string; text: string }[] = [];
    function log(kind: string, text: string) {
      entries.push({ t: fmtTime(new Date()), kind, text });
      if (entries.length > 250) entries.shift();
      if (conBody?.innerHTML) {
        conBody.innerHTML = entries
          .map((e) =>
            e.kind === "raw"
              ? `<div class="cline k-raw">${e.text}</div>`
              : `<div class="cline k-${e.kind}"><span class="lt">${e.t}</span><span class="lp">${
                  e.kind === "cmd"
                    ? "❯"
                    : e.kind === "sys"
                      ? "▸"
                      : e.kind === "ok"
                        ? "✓"
                        : e.kind === "err"
                          ? "✗"
                          : " "
                }</span><span class="lx">${e.text}</span></div>`,
          )
          .join("");
      }
      if (conBody?.scrollTop) {
        conBody.scrollTop = conBody?.scrollHeight;
      }
      let last;
      if (conBody) {
        last = conBody.lastElementChild;
      }
      if (last) last.classList.add("fresh");
    }
    function outs(lines: string[]) {
      lines.forEach((l) => log("out", l));
    }

    /* ═══════════════ grep / cat corpus (built from the same data) ═══════════════ */
    const CORPUS: { f: string; t: string }[] = [];
    (function buildCorpus() {
      const put = (f: string, t: string) => CORPUS.push({ f, t });
      put("about.md", ABOUT.tag);
      ABOUT.fm.forEach(([k, v]) => put("about.md", `${k}: ${v}`));
      ABOUT.paras.forEach((p) => put("about.md", p));
      ABOUT.principles.forEach(([a, b]) => put("about.md", `${a} — ${b}`));
      ABOUT.now.forEach(([k, v]) => put("about.md", `${k}: ${v}`));
      ACH.forEach((a) => put("projects/achievements.log", `${a.y} · ${a.t}`));
      PROJECTS.forEach((p) => {
        const f = "projects/" + p.id;
        put(f, `${p.name} — ${p.tag}`);
        put(f, p.desc);
        put(f, `stack: ${p.stack}`);
        put(f, `role: ${p.role}`);
        put(f, `impact: ${p.impact}`);
        put(f, `year: ${p.year}`);
      });
      SKILLS.groups.forEach((g) =>
        g.rows.forEach(([n, p, y]) =>
          put("skills.json", `${n} — ${p}% · ${y}y (${g.name})`),
        ),
      );
      put("skills.json", `learning: ${SKILLS.learning}`);
      CONTACT.rows.forEach((r) =>
        put("contact.txt", `${r.k}: ${r.v.replace(/<[^>]+>/g, "")}`),
      );
      put("contact.txt", CONTACT.status);
      put("contact.txt", CONTACT.note);
    })();

    /* ═══════════════ page renderers ═══════════════ */
    const phead = (file, tag) => `
  <div class="ph"><span class="d2">#</span> <b class="pf">${file}</b><span class="meta" id="metaLine"></span></div>
  <div class="pt">${tag}</div><div class="rule"></div>`;

    function renderAbout() {
      return (
        phead("about.md", ABOUT.tag) +
        `
  <div class="fm">
    <div class="fmd">---</div>
    ${ABOUT.fm.map(([k, v]) => `<div class="fr"><span class="k">${k}:</span><span class="v">${k === "status" ? `<span class="grn">●</span> open to work` : h(v)}</span></div>`).join("")}
    <div class="fmd">---</div>
  </div>
  <div class="prose">${ABOUT.paras.map((p) => `<p>${p}</p>`).join("")}</div>
  <div class="h2"><span class="hh">##</span> principles</div>
  <div class="dl pr">${ABOUT.principles
    .map(
      ([a, b]) =>
        `<div class="dr"><span class="k">${a}</span><span class="v dim">${b}</span></div>`,
    )
    .join("")}</div>
  <div class="h2"><span class="hh">##</span> now<span class="h2r d2">updated 2025-05</span></div>
  <div class="dl">${ABOUT.now
    .map(
      ([k, v]) =>
        `<div class="dr"><span class="k dim">${k}:</span><span class="v">${h(v)}</span></div>`,
    )
    .join("")}</div>`
      );
    }

    function renderProjects() {
      return (
        phead("projects/", TABS[1].tag) +
        `
  <div class="pintro">▸ click a project to expand — or use open &lt;name&gt; in the console</div>
  ${PROJECTS.map(
    (p) => `
  <article class="proj ${state.open.has(p.id) ? "open" : ""}" data-p="${p.id}">
    <button class="prow" aria-expanded="${state.open.has(p.id)}">
      <span class="pc">${state.open.has(p.id) ? "▾" : "▸"}</span>
      <span class="pn">${p.name}</span>
      <span class="pt2">${p.tag}</span>
      <span class="ps">${p.short}</span>
      <span class="pst ${p.st}">[${p.st}]</span>
    </button>
    <div class="pbody"><div class="pinner">
      <p class="pdesc">${p.desc}</p>
      <div class="pd">
        <span class="k">role</span><span class="v">${p.role}</span>
        <span class="k">stack</span><span class="v">${p.stack}</span>
        <span class="k">impact</span><span class="vi">${p.impact}</span>
        <span class="k">year</span><span class="v dim">${p.year}</span>
      </div>
    </div></div>
  </article>`,
  ).join("")}
  <section id="ach">
    <div class="h2"><span class="hh">##</span> achievements.log<span class="h2r d2">newest first</span></div>
    ${ACH.map(
      (
        a,
      ) => `<div class="ach-row"><span class="a1">*</span><span class="a2">${a.h}</span>
      <span class="a3">${a.y}</span><span class="v">${h(a.t)}</span></div>`,
    ).join("")}
    <div class="ach-foot">${ACH.length} entries · 2022 → 2025 · click a project above for context</div>
  </section>`
      );
    }

    function renderSkills() {
      const bar = (p) =>
        `<span class="bf">${"█".repeat(Math.round(p / 10))}</span><span class="br">${"░".repeat(10 - Math.round(p / 10))}</span>`;
      return (
        phead("skills.json", TABS[2].tag) +
        `
  ${SKILLS.groups
    .map(
      (g) => `
    <div class="h2"><span class="hh">##</span> ${g.name}<span class="h2r d2">${g.rows.length} competences</span></div>
    ${g.rows
      .map(
        ([
          n,
          p,
          y,
        ]) => `<div class="meter" data-si="${h(`${n} — ${p}% · ${y}y (${g.name})`)}" title="click for the log entry">
      <span class="mn">${n}</span><span class="mb">${bar(p)}</span>
      <span class="mp">${p}%</span><span class="my">${y}y</span></div>`,
      )
      .join("")}`,
    )
    .join("")}
  <div class="learn"><span class="acc">▮ learning:</span> ${SKILLS.learning}</div>
  <div class="snote"># bars are self-assessed — benchmarks available on request</div>`
      );
    }

    function renderContact() {
      return (
        phead("contact.txt", TABS[3].tag) +
        `
  <div class="cbox">
    <div class="dl dr"><span class="k dim">status:</span><span class="v grn">${CONTACT.status}</span></div>
    ${CONTACT.rows
      .map(
        (r) =>
          `<div class="dr"><span class="k dim">${r.k}:</span><span class="v">${r.v}${
            r.copy
              ? `<button class="copy" data-copy="${h(r.v)}" title="copy ${r.k}">[copy]</button>`
              : ""
          }</span></div>`,
      )
      .join("")}
  </div>
  <div class="cnote">${CONTACT.note}</div>`
      );
    }

    const PAGES = {
      about: { file: "about.md", render: renderAbout },
      projects: { file: "projects/", render: renderProjects },
      skills: { file: "skills.json", render: renderSkills },
      contact: { file: "contact.txt", render: renderContact },
    };

    /* ═══════════════ navigation ═══════════════ */
    function go(page, o = {}) {
      const same = state.page === page;
      if (same && !o.anchor) {
        pane.scrollTo({ top: 0, behavior: smooth() });
        return;
      }
      state.page = page;
      tabsEl
        .querySelectorAll(".tab")
        .forEach((t) => t.classList.toggle("on", t.dataset.page === page));
      treeEl
        .querySelectorAll("[data-nav]")
        .forEach((n) => n.classList.toggle("on", n.dataset.nav === page));
      const P = PAGES[page];
      pageEl.innerHTML = P.render();
      $("#sbFile").textContent = P.file;
      if (pageEl.animate)
        pageEl.animate([{ opacity: 0.3 }, { opacity: 1 }], { duration: 130 });
      requestAnimationFrame(() => {
        const m = pageEl.querySelector("#metaLine");
        if (m)
          m.textContent =
            "~ " + Math.max(1, Math.round(pageEl.offsetHeight / 20)) + " lines";
      });
      if (o.anchor) {
        const el = pageEl.querySelector("#" + o.anchor);
        if (el) {
          setTimeout(() => {
            el.scrollIntoView({ behavior: smooth(), block: "start" });
            el.classList.add("flashsec");
            setTimeout(() => el.classList.remove("flashsec"), 1200);
          }, 60);
        }
      } else pane.scrollTop = 0;
      if (!o.silent && !same) log("sys", "open " + P.file);
    }

    function openProject(id, scroll = true) {
      state.open.add(id);
      if (state.page !== "projects") go("projects");
      const art = pageEl.querySelector(`[data-p="${id}"]`);
      if (art) {
        art.classList.add("open");
        art.querySelector(".prow").setAttribute("aria-expanded", "true");
        art.querySelector(".pc").textContent = "▾";
        if (scroll) {
          art.scrollIntoView({ behavior: smooth(), block: "nearest" });
          art.classList.add("flash");
          setTimeout(() => art.classList.remove("flash"), 1100);
        }
      }
    }

    /* ═══════════════ sidebar tree + theme ═══════════════ */
    function buildTree() {
      let out = "";
      TREE.forEach((n, i) => {
        const last = i === TREE.length - 1;
        out += `<button class="tnode" data-nav="${n.nav}"><span class="tg">${last ? "└─" : "├─"}</span>
      <span class="tn">${n.n}</span><span class="tm ${n.cls || ""}">${n.m}</span></button>`;
        (n.kids || []).forEach((k, j) => {
          const lk = j === n.kids.length - 1;
          const attr = k.ach ? 'data-ach="1"' : `data-proj="${k.proj}"`;
          out += `<button class="tnode" ${attr}><span class="tg">│ ${lk ? "└─" : "├─"}</span>
        <span class="tn">${k.n}</span><span class="tm ${k.cls || ""}">${k.m}</span></button>`;
        });
      });
      treeEl.innerHTML = out;
    }
    treeEl.addEventListener("click", (e) => {
      const b = e.target.closest(".tnode");
      if (!b) return;
      if (b.dataset.nav) return go(b.dataset.nav);
      if (b.dataset.ach) return go("projects", { anchor: "ach" });
      if (b.dataset.proj) return openProject(b.dataset.proj);
    });

    const THEMES = ["amber", "phosphor", "paper"];
    function buildThemeRow() {
      $("#themeRow").innerHTML = THEMES.map(
        (t) =>
          `<button class="thm ${t === state.theme ? "on" : ""}" data-thm="${t}">${t}</button>`,
      ).join("");
    }
    $("#themeRow").addEventListener("click", (e) => {
      const b = e.target.closest("[data-thm]");
      if (b) setTheme(b.dataset.thm);
    });
    function setTheme(name, o = {}) {
      if (!THEMES.includes(name)) return;
      state.theme = name;
      document.body.dataset.theme = name;
      $("#sbTheme").textContent = name;
      document
        .querySelectorAll(".thm")
        .forEach((b) => b.classList.toggle("on", b.dataset.thm === name));
      try {
        localStorage.setItem("pf-theme", name);
      } catch (e) {}
      if (!o.silent) log("ok", "theme ▸ " + name);
    }
    function cycleTheme() {
      setTheme(THEMES[(THEMES.indexOf(state.theme) + 1) % THEMES.length]);
    }

    /* ═══════════════ tabs ═══════════════ */
    tabsEl.addEventListener("click", (e) => {
      const t = e.target.closest(".tab");
      if (t) go(t.dataset.page);
    });
    const prevTab = () =>
      go(
        TABS[
          (TABS.findIndex((t) => t.id === state.page) + TABS.length - 1) %
            TABS.length
        ].id,
      );
    const nextTab = () =>
      go(
        TABS[(TABS.findIndex((t) => t.id === state.page) + 1) % TABS.length].id,
      );

    /* ═══════════════ in-page interactions ═══════════════ */
    pageEl.addEventListener("click", (e) => {
      const c = e.target.closest("[data-copy]");
      if (c) return doCopy(c);
      if (e.target.closest("[data-cv]"))
        return log(
          "ok",
          "cv request logged — one email to hello@avega.dev and it's yours",
        );
      const sk = e.target.closest("[data-si]");
      if (sk) return log("out", "skill ▸ " + h(sk.dataset.si));
      const pr = e.target.closest(".prow");
      if (pr) {
        const art = pr.closest(".proj"),
          id = art.dataset.p;
        const open = art.classList.toggle("open");
        open ? state.open.add(id) : state.open.delete(id);
        pr.setAttribute("aria-expanded", open);
        pr.querySelector(".pc").textContent = open ? "▾" : "▸";
      }
    });
    function doCopy(btn) {
      const val = btn.dataset.copy;
      const done = () => {
        btn.textContent = "[copied]";
        btn.classList.add("copied");
        log("ok", "copied ▸ " + h(val));
        setTimeout(() => {
          btn.textContent = "[copy]";
          btn.classList.remove("copied");
        }, 1400);
      };
      if (navigator.clipboard && navigator.clipboard.writeText)
        navigator.clipboard
          .writeText(val)
          .then(done)
          .catch(() => fallback());
      else fallback();
      function fallback() {
        const ta = document.createElement("textarea");
        ta.value = val;
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand("copy");
          done();
        } catch (e) {
          log("err", "clipboard blocked — select & copy manually");
        }
        ta.remove();
      }
    }

    /* ═══════════════ command input ═══════════════ */
    cmd.addEventListener("input", () => {
      mirror.textContent = cmd.value;
    });
    cmd.addEventListener("focus", () => {
      document.body.classList.add("cmd-on");
      $("#sbMode").textContent = "COMMAND";
    });
    cmd.addEventListener("blur", () => {
      document.body.classList.remove("cmd-on");
      $("#sbMode").textContent = "NORMAL";
    });
    cmd.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        const v = cmd.value;
        cmd.value = "";
        mirror.textContent = "";
        hIdx = -1;
        if (v.trim()) exec(v);
      } else if (e.key === "ArrowUp") {
        if (hist.length) {
          hIdx = hIdx < 0 ? hist.length - 1 : Math.max(0, hIdx - 1);
          cmd.value = hist[hIdx];
          mirror.textContent = cmd.value;
        }
        e.preventDefault();
      } else if (e.key === "ArrowDown") {
        if (hIdx >= 0) {
          hIdx++;
          if (hIdx >= hist.length) {
            hIdx = -1;
            cmd.value = "";
          } else cmd.value = hist[hIdx];
          mirror.textContent = cmd.value;
        }
        e.preventDefault();
      } else if (e.key === "Escape") {
        cmd.blur();
        e.preventDefault();
      }
    });
    $("#cmdrow").addEventListener("click", () => cmd.focus());

    /* ═══════════════ global keys ═══════════════ */
    document.addEventListener("keydown", (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (!overlay.classList.contains("open")) {
        if (document.activeElement === cmd) return;
        const k = e.key;
        if (k === ":" || k === "/") {
          e.preventDefault();
          cmd.focus();
          if (k === ":") {
            cmd.value = ":";
            mirror.textContent = ":";
          }
          return;
        }
        if (k === "?") {
          e.preventDefault();
          return openHelp();
        }
        if (k >= "1" && k <= "4") return go(TABS[+k - 1].id);
        if (k === "j" || k === "ArrowDown") {
          pane.scrollBy({ top: 34, behavior: smooth() });
          e.preventDefault();
          return;
        }
        if (k === "k" || k === "ArrowUp") {
          pane.scrollBy({ top: -34, behavior: smooth() });
          e.preventDefault();
          return;
        }
        if (k === "G" || k === "End") {
          pane.scrollTop = pane.scrollHeight;
          return;
        }
        if (k === "Home") {
          pane.scrollTop = 0;
          return;
        }
        if (k === "g") {
          if (gg) {
            pane.scrollTop = 0;
            gg = false;
          } else {
            gg = true;
            setTimeout(() => (gg = false), 600);
          }
          return;
        }
        if (k === "h") return prevTab();
        if (k === "l") return nextTab();
        if (k === "t") return cycleTheme();
      } else {
        if (e.key === "Escape" || e.key === "?") {
          e.preventDefault();
          closeOverlay();
        }
      }
    });

    /* ═══════════════ command engine ═══════════════ */
    function exec(raw: string) {
      const shown = raw.trim();
      const clean = shown.replace(/^[:/]+/, "").trim();
      if (!clean) return;
      if (hist[hist.length - 1] !== clean) hist.push(clean);
      log("cmd", h(shown.replace(/^[:]+/, "").trim() || shown));
      const [c, ...rest] = clean.split(/\s+/);
      const cmd0 = c.toLowerCase(),
        arg = rest.join(" ");
      switch (cmd0) {
        case "help":
        case "h":
          openHelp();
          break;
        case "ls":
          cmdLs(arg);
          break;
        case "cd":
          cmdCd(arg);
          break;
        case "cat":
          cmdCat(arg);
          break;
        case "open":
        case "e":
          cmdOpen(arg);
          break;
        case "about":
        case "projects":
        case "skills":
        case "contact":
          go(cmd0);
          break;
        case "whoami":
          outs([
            "adrián vega — senior full-stack developer (bucharest · utc+2)",
            "7+ years · typescript / go / postgres — end to end",
            "now: ledgerline v2 · learning rust",
            "tl;dr — open projects/, or run neofetch",
          ]);
          break;
        case "theme":
          cmdTheme(arg);
          break;
        case "grep":
          cmdGrep(arg);
          break;
        case "echo":
          log("out", h(arg));
          break;
        case "history":
          log(
            "out",
            hist
              .slice(-15)
              .map((x, i) => String(i + 1).padStart(3, " ") + "  " + h(x))
              .join("\n") || "(empty)",
          );
          break;
        case "clear":
          entries.length = 0;
          conBody!.innerHTML = "";
          log("sys", "console cleared");
          break;
        case "date":
          log(
            "out",
            h(
              new Date().toLocaleString("en-GB", {
                dateStyle: "full",
                timeStyle: "medium",
              }),
            ),
          );
          break;
        case "uptime": {
          const s = Math.floor((Date.now() - state.bootAt) / 1000);
          log(
            "out",
            `up ${Math.floor(s / 60)}m ${s % 60}s · ${hist.length} commands · load: coffee`,
          );
          break;
        }
        case "pwd":
          log("out", "/home/avega/portfolio");
          break;
        case "neofetch":
          openNeofetch();
          break;
        case "cowsay":
          cmdCow(arg);
          break;
        case "sudo":
          if ((rest[0] || "").toLowerCase() === "hire-me") hireSeq();
          else log("err", "usage: sudo hire-me");
          break;
        case "hire-me":
          log(
            "err",
            "permission denied — are you sure you're not root? try sudo hire-me",
          );
          break;
        case "q":
          log(
            "out",
            "E37: no write since last change — and no :q out of a portfolio. try :contact",
          );
          break;
        case "w":
          log("out", "E45: buffer is read-only — the work is already public");
          break;
        case "wq":
          log("out", "E45: nothing to save. see :w, then :q, then :contact");
          break;
        case "q!":
          log(
            "out",
            "force-quit blocked — this portfolio follows you now. (try :contact)",
          );
          break;
        case "exit":
          log("out", "there is no exit. only :contact.");
          break;
        default:
          log(
            "err",
            h(`command not found: ${c}`) +
              ' <span class="d2">(type help)</span>',
          );
      }
    }
    function cmdLs(a: string) {
      a = (a || "").replace(/\/$/, "");
      if (!a || a === "~" || a === ".")
        return log(
          "out",
          '<span class="acc">projects/</span>  about.md  skills.json  contact.txt',
        );
      if (a === "projects")
        return log(
          "out",
          'achievements.log  dispatchr  formforge  ledgerline  pulseboard  syncroom <span class="d2">(open &lt;name&gt; to expand)</span>',
        );
      log("err", `ls: ${h(a)}: no such directory`);
    }
    function cmdCd(a: string) {
      a = (a || "").replace(/\/$/, "");
      if (!a || a === "~" || a === ".." || a === "home") return go("about");
      if (a === "projects") return go("projects");
      if (a.startsWith("projects/")) return cmdOpen(a.slice(9));
      const t = matchTarget(a);
      if (t) return applyTarget(t);
      log("err", `cd: no such directory: ${h(a)}`);
    }
    function cmdOpen(a: string) {
      if (!a) return log("err", "open what? — try open ledgerline");
      const t = matchTarget(a);
      t ? applyTarget(t) : log("err", `no such buffer: ${h(a)} (try ls)`);
    }
    function matchTarget(name: string) {
      name = name
        .toLowerCase()
        .replace(/\.md$|\.json$|\.txt$|\.log$/, "")
        .replace(/\/$/, "");
      if (
        name === "ach" ||
        name === "achievements" ||
        name === "achievements.log"
      )
        return { page: "projects", anchor: "ach" };
      const page = TABS.find((t) => t.id === name);
      if (page) return { page: page.id };
      const p = PROJECTS.find(
        (p) => p.id === name || p.name.toLowerCase() === name,
      );
      if (p) return { proj: p.id };
      return null;
    }
    function applyTarget(t: any) {
      if (t.proj) openProject(t.proj);
      else go(t.page, { anchor: t.anchor });
    }
    function cmdCat(a) {
      if (!a) return log("err", "usage: cat <file>");
      a = a.toLowerCase();
      let file = null;
      if (a === "about" || a === "about.md") file = "about.md";
      if (a === "skills" || a === "skills.json") file = "skills.json";
      if (a === "contact" || a === "contact.txt") file = "contact.txt";
      if (a === "projects" || a === "projects/")
        file = "projects/achievements.log";
      const p = PROJECTS.find((p) => p.id === a || p.name.toLowerCase() === a);
      if (p) file = "projects/" + p.id;
      if (!file) return log("err", `cat: ${h(a)}: no such file`);
      const rows = CORPUS.filter((x) => x.f === file);
      log(
        "out",
        rows
          .map(
            (r, i) =>
              `<span class="d2">${String(i + 1).padStart(3, " ")}│</span> ${h(r.t)}`,
          )
          .join("\n"),
      );
    }
    function cmdTheme(a) {
      if (!a)
        return log(
          "out",
          `themes: amber · phosphor · paper <span class="d2">— current: ${state.theme}</span>`,
        );
      THEMES.includes(a)
        ? setTheme(a)
        : log("err", `unknown theme: ${h(a)} — try amber · phosphor · paper`);
    }
    function cmdGrep(q) {
      if (!q)
        return log("out", "usage: grep <pattern> — searches every buffer");
      const ql = q.toLowerCase();
      const hits = CORPUS.filter((x) => x.t.toLowerCase().includes(ql));
      if (!hits.length) return log("err", `no matches for "${h(q)}" (exit 1)`);
      const shown = hits.slice(0, 12);
      log(
        "out",
        shown
          .map(
            (x) =>
              `<span class="tl">${h(x.f)}</span><span class="d2">:</span>${h(x.t)}`,
          )
          .join("\n") +
          (hits.length > 12
            ? `\n<span class="d2">… ${hits.length - 12} more — narrow the query</span>`
            : ""),
      );
    }
    function cmdCow(m) {
      m = (m || "hire me").slice(0, 44);
      const w = m.length + 2;
      const lines = [
        ` ${"_".repeat(w)}`,
        `< ${h(m)} >`,
        ` ${"-".repeat(w)}`,
        "        \\   ^__^",
        "         \\  (oo)\\_______",
        "            (__)\\       )\\/\\",
        "                ||----w |",
        "                ||     ||",
      ];
      lines.forEach((l) => log("raw", l));
    }
    function hireSeq() {
      if (state.hiring) return;
      state.hiring = true;
      log("out", "[sudo] password for visitor: ********");
      setTimeout(() => log("ok", "access granted — routing request"), 500);
      setTimeout(() => {
        log("ok", "opening contact.txt …");
        go("contact");
        state.hiring = false;
      }, 1200);
    }

    /* ═══════════════ overlays ═══════════════ */
    function openDlg(title, sub, html) {
      dlgTitle.textContent = title;
      dlgSub.textContent = sub;
      dlgBody.innerHTML = html;
      overlay.classList.add("open");
    }
    function closeOverlay() {
      overlay.classList.remove("open");
    }
    $("#dlgClose").addEventListener("click", closeOverlay);
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) closeOverlay();
    });

    function openHelp() {
      openDlg(
        "help",
        "portfolio.sh — everything is clickable too",
        `
  <div class="help-grid">
    <div>
      <div class="h2 sm"><span class="d2">##</span> commands</div>
      ${[
        ["ls [dir]", "list buffers — ls projects for details"],
        ["cat <file>", "print a buffer with line numbers"],
        ["cd <page>", "navigate — cd projects"],
        ["open <x>", "jump to a page or project, expanded"],
        ["theme <t>", "amber · phosphor · paper"],
        ["grep <q>", "search across every buffer"],
        ["whoami", "the short version"],
        ["neofetch", "system card, live values"],
        ["cowsay <t>", "essential infrastructure"],
        ["history", "past commands"],
        ["clear", "wipe the console"],
      ]
        .map(([a, b]) => `<div class="hc"><b>${a}</b><span>${b}</span></div>`)
        .join("")}
    </div>
    <div>
      <div class="h2 sm"><span class="d2">##</span> keys</div>
      ${[
        [": or /", "focus the command line"],
        ["1 – 4", "switch tabs"],
        ["h / l", "previous / next tab"],
        ["j / k", "scroll the buffer"],
        ["g g / G", "top / bottom"],
        ["t", "cycle theme"],
        ["?", "this panel"],
        ["esc", "close panel · blur input"],
      ]
        .map(([a, b]) => `<div class="hc"><b>${a}</b><span>${b}</span></div>`)
        .join("")}
      <div class="help-note">also lurking: whoami · uptime · date · echo · pwd · :q · sudo hire-me</div>
    </div>
  </div>`,
      );
    }

    const box = (lines) => {
      const w = Math.max(...lines.map((l) => l.length));
      return [
        `┌${"─".repeat(w + 2)}┐`,
        ...lines.map((l) => `│ ${l.padEnd(w)} │`),
        `└${"─".repeat(w + 2)}┘`,
      ];
    };
    function openNeofetch() {
      const s = Math.floor((Date.now() - state.bootAt) / 1000);
      const art = box([
        "▮ portfolio.sh",
        "",
        " ~ ❯ whoami",
        " adrián vega",
        " ~ ❯ role",
        " senior full-stack dev",
        " ~ ❯ status",
        " ● open to work _",
      ]).join("\n");
      openDlg(
        "neofetch",
        "system card — real values, read at open time",
        `
    <div class="nf">
      <pre class="nf-art">${h(art)}</pre>
      <div class="nf-i">
        <span class="k">user</span><span class="v">adrián vega</span>
        <span class="k">role</span><span class="v">senior full-stack</span>
        <span class="k">host</span><span class="v">portfolio.sh v2.1</span>
        <span class="k">uptime</span><span class="v">${Math.floor(s / 60)}m ${s % 60}s</span>
        <span class="k">shell</span><span class="v">portfolio.sh</span>
        <span class="k">theme</span><span class="v">${state.theme}</span>
        <span class="k">viewport</span><span class="v">${innerWidth}×${innerHeight}</span>
        <span class="k">buffers</span><span class="v">4 tabs · ${PROJECTS.length} projects</span>
        <span class="k">location</span><span class="v">Bucharest · UTC+2</span>
        <span class="k">status</span><span class="v grn">● open to work</span>
      </div>
    </div>`,
      );
    }

    /* ═══════════════ clock ═══════════════ */
    function buch() {
      try {
        return new Date().toLocaleTimeString("en-GB", {
          timeZone: "Europe/Bucharest",
        });
      } catch (e) {
        return fmtTime(new Date());
      }
    }
    setInterval(() => {
      const now = new Date(),
        t = fmtTime(now);
      $("#tbClock").textContent = t;
      $("#sbClock").textContent = t;
      $("#tbDate").textContent = now.toLocaleDateString("en-GB", {
        weekday: "short",
        day: "2-digit",
        month: "short",
      });
      const z = pageEl.querySelector("#tzLive");
      if (z) z.textContent = buch();
    }, 1000);

    /* ═══════════════ console clear + boot ═══════════════ */
    $("#clearBtn").addEventListener("click", () => {
      entries.length = 0;
      conBody.innerHTML = "";
      log("sys", "console cleared");
    });

    function boot() {
      requestAnimationFrame(() => document.body.classList.remove("pre"));
      const lines = [
        ["sys", "portfolio.sh v2.1.0 — booting"],
        ["sys", "mount /home/avega … ok"],
        ["sys", "index 4 buffers · 6 projects · grep index … ok"],
        ["sys", "themes ▸ amber · phosphor · paper … ok"],
        [
          "ok",
          `ready in ${Math.round(performance.now())} ms — this console is real. type help`,
        ],
      ];
      lines.forEach((l, i) => setTimeout(() => log(l[0], l[1]), 250 + i * 180));
    }

    /* ═══════════════ init ═══════════════ */
    (function init() {
      buildTree();
      buildThemeRow();
      const saved = (() => {
        try {
          return localStorage.getItem("pf-theme");
        } catch (e) {
          return null;
        }
      })();
      if (saved && THEMES.includes(saved)) setTheme(saved, { silent: true });
      go("about", { silent: true });
      boot();
      document.fonts &&
        document.fonts.ready.then(() => {
          // recalc line counts once the mono font lands
          const m = pageEl.querySelector("#metaLine");
          if (m)
            m.textContent =
              "~ " +
              Math.max(1, Math.round(pageEl.offsetHeight / 20)) +
              " lines";
        });
    })();
  </script>
</Layout>
