<div class="cmdrow" id="cmdrow" title="command line — type help">
  <span class="prompt"><!-- ❯ -->{"$"}</span>
  <div class="cmd-wrap" id="cmdWrap">
    <span class="mirror" id="mirror"></span><span
      class="caret"
      aria-hidden="true"></span>
    <input
      id="cmd"
      autocomplete="off"
      spellcheck="false"
      aria-label="command input"
    />
  </div>
  <span class="cmd-hint" id="cmdHint"
    >type help — or press ? for shortcuts · mouse works too</span
  >
</div>
