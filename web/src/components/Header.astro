---

---
<header class="topbar">
    <!-- <span class="blink" aria-hidden="true">▮</span> -->
    <b>vi-dev</b><span class="dim">@portfolio.sh</span>
    <span class="d2 tb-mid">v2.1 · full-stack</span>
    <span class="tb-right">
      <span class="d2" id="tbDate">—</span>
      <span class="dim" id="tbClock">--:--:--</span>
    </span>
  </header>
  <script>
import { $, fmtTime } from "../shared";

    /* ═══════════════ clock ═══════════════ */
    function buch() {
      try {
        return new Date().toLocaleTimeString("ru-RU", {
          timeZone: "Europe/Moscow",
        });
      } catch (e) {
        return fmtTime(new Date());
      }
    }
    setInterval(() => {
      const now = new Date(),
        t = fmtTime(now);
      $("#tbClock")!.textContent = t;
      $("#sbClock")!.textContent = t;
      $("#tbDate")!.textContent = now.toLocaleDateString("ru-RU", {
        weekday: "long",
        day: "2-digit",
        month: "short",
      });
      const z = document.querySelector("#tzLive");
      if (z) z.textContent = buch();
    }, 1000);
  </script>