---
import "../styles/global.css";
import { tabByPath } from "../data/portfolio";
import TopBar from "../components/TopBar.astro";
import Tabline from "../components/Tabline.astro";
import Sidebar from "../components/Sidebar.astro";
import Console from "../components/Console.astro";
import StatusBar from "../components/StatusBar.astro";
import Overlay from "../components/Overlay.astro";

interface Props {
  tab?: string; // active tab id (about | projects | skills | contact | '')
  file?: string; // status-bar file for this buffer
  title?: string;
  description?: string;
}
const {
  tab = "",
  file = "",
  title = "vi-dev · portfolio.sh",
  description = "Fullstack-разработчик — Node, Bun, Next, Astro, AI. Портфолио в виде терминала.",
} = Astro.props;

const active = (tab || tabByPath(Astro.url.pathname)?.id) ?? "";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-theme="amber" class="pre" data-tab={active}>
    <div class="app">
      <TopBar />
      <Tabline active={active} />
      <div class="mid">
        <Sidebar active={active} />
        <main class="pane" id="pane">
          <div class="col">
            <div id="page">
              <slot />
            </div>
            <div class="tildes" aria-hidden="true">~ ~ ~ ~ ~</div>
          </div>
        </main>
      </div>
      <Console />
      <StatusBar file={file} />
    </div>
    <Overlay />
    <div class="crt" aria-hidden="true"></div>
    <script>
      import "../scripts/terminal.js";
    </script>
    <script>
      import "../scripts/focus-terminal.js";
    </script>
  </body>
</html>
