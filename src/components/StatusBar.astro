---
interface Props { file: string }
const { file } = Astro.props;
---
<footer class="statusbar">
  <span class="mode" id="sbMode">NORMAL</span>
  <span class="sb-file">{file}</span>
  <span class="sb-keys">: cmd · j/k скролл · 1-4 вкладки · t тема · +/− шрифт · ? помощь</span>
  <span class="sb-right">
    <span class="acc" id="sbTheme">amber</span>
    <span class="dim" id="sbClock">--:--:--</span>
    <span class="d2" id="sbTrace">trace 1a16a8b7</span>
  </span>
</footer>
