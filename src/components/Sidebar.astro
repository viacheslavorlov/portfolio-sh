---
import { PROJECTS, projectPath } from '../data/portfolio';

interface Props { active: string }
const { active } = Astro.props;
const children = [...PROJECTS].sort((a, b) => a.id.localeCompare(b.id));
---
<aside class="sidebar">
  <div class="side-sec">
    <div class="sec-label">explorer</div>
    <div class="tree">
      <a class:list={['tnode', { on: active === 'about' }]} href="/portfolio-sh/">
        <span class="tg">├─</span><span class="tn">about.md</span><span class="tm">2kB</span>
      </a>
      <a class:list={['tnode', { on: active === 'projects' }]} href="/portfolio-sh/projects/">
        <span class="tg">├─</span><span class="tn">projects/</span><span class="tm">{children.length + 1}</span>
      </a>
      <a class="tnode" href="/portfolio-sh/projects/#ach">
        <span class="tg">│ ├─</span><span class="tn">achievements.log</span><span class="tm">{6}</span>
      </a>
      {children.map((p, i) => (
        <a class="tnode" href={projectPath(p)} aria-current={Astro.url.pathname === projectPath(p) ? 'page' : undefined}>
          <span class="tg">│ {i === children.length - 1 ? '└─' : '├─'}</span>
          <span class="tn">{p.name}</span><span class="tm st-{p.st}">{p.st}</span>
        </a>
      ))}
      <a class:list={['tnode', { on: active === 'skills' }]} href="/portfolio-sh/skills/">
        <span class="tg">├─</span><span class="tn">skills.json</span><span class="tm">1kB</span>
      </a>
      <a class:list={['tnode', { on: active === 'contact' }]} href="/portfolio-sh/contacts/">
        <span class="tg">└─</span><span class="tn">contact.txt</span><span class="tm">1kB</span>
      </a>
    </div>
  </div>
  <div class="side-sec">
    <div class="sec-label">session</div>
    <div class="sess">
      <div class="s1">viacheslav</div>
      <div class="d2">fullstack-разработчик</div>
      <div class="d2">4 г. 4 мес. · Новгород · UTC+3</div>
      <div class="grn s1">● доступен для найма</div>
    </div>
  </div>
  <div class="side-sec">
    <div class="sec-label">theme</div>
    <div class="theme-row" id="themeRow">
      <button class="thm" data-thm="amber">amber</button>
      <button class="thm" data-thm="phosphor">phosphor</button>
      <button class="thm" data-thm="paper">paper</button>
    </div>
  </div>
</aside>
